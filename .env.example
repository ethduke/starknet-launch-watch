# Keep the real .env local. Never paste credentials into chat or commands.
STARKNET_RPC_URL=
# Optional: subscriptions wake the HTTP recovery loop; polling always remains active.
STARKNET_RPC_WS_URL=
# Both required for Telegram delivery; leave both blank for console alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: where scanning begins on the first run. Existing DB checkpoints win.
# START_BLOCK=16100000
POLL_INTERVAL_SECS=5
BLOCK_BATCH_SIZE=100
DATABASE_PATH=data/watch.sqlite
REGISTRY_PATH=config/mainnet.json
